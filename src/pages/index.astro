---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title={"Marine technologist. — Dan Vallentyne"}
  description={"I'm Dan Vallentyne. I support marine researchers, conduct underwater surveys, contribute to scientific research, and build software that helps people work with environmental data."}
  bodyClass="home"
>
  <link slot="head" rel="preload" as="image" href="/assets/mosiac24-hero.webp">
  <section class="hero" aria-labelledby="hero-title">
    <img src="/assets/mosiac24-hero.webp" alt="Close-up of a reconstructed Colpophyllia natans colony" width="1600" height="900" fetchpriority="high" class="hero-image">
    <video class="hero-image hero-video" poster="/assets/mosiac24-hero.webp" muted loop playsinline preload="none" hidden aria-hidden="true" data-src="/assets/mosiac24-hero.mp4" data-hls="/assets/video/mosiac24-hero/master.m3u8?v=20261111-original-start"></video>
    <video class="hero-image hero-video" muted loop playsinline preload="none" hidden aria-hidden="true" data-src="/assets/survey-tools-hero.mp4" data-hls="/assets/video/survey-tools-hero/master.m3u8?v=20261111-original-start" data-poster="/assets/survey-tools-hero.webp"></video>
    <video class="hero-image hero-video" muted loop playsinline preload="none" hidden aria-hidden="true" data-src="/assets/karapata-south-loop-v15.mp4" data-hls="/assets/video/karapata-south-loop-v15/master.m3u8" data-poster="/assets/karapata-south-loop-v15.jpg"></video>
    <div class="wrap hero-content">
      <div class="hero-copy">
        <h1 class="type-display" id="hero-title">Marine technologist.</h1>
        <p class="hero-description">I&#x27;m Dan Vallentyne. I support marine researchers, conduct underwater surveys, contribute to scientific research, and build software that helps people work with environmental data.</p>
        <div class="hero-actions">
          <a class="button button-outline" href="#projects">Explore my work</a>
        </div>
      </div>
    </div>
    <div class="wrap hero-bottom">
      <div class="hero-scenes" role="group" aria-label="Explore field imagery"><button class="scene-button" aria-pressed="true" data-image="/assets/mosiac24-hero.webp" data-alt="Close-up of a reconstructed Colpophyllia natans colony" data-caption="Colpophyllia natans coral colony" data-details="3D photogrammetry reconstruction" data-context="Bonaire • 1 August 2023 • pre-SCTLD" data-video="/assets/mosiac24-hero.mp4">01 &nbsp; Reef imagery</button><button class="scene-button" aria-pressed="false" data-image="/assets/survey-tools-hero.webp" data-alt="Divers using survey cameras and a stereo camera rig over a Bonaire reef" data-caption="Custom stereo camera rig" data-details="Underwater survey equipment" data-context="Bonaire Baseline Scans • 2026" data-video="/assets/survey-tools-hero.mp4">02 &nbsp; Survey tools</button><button class="scene-button" aria-pressed="false" data-image="/assets/karapata-south-loop-v15.jpg" data-video="/assets/karapata-south-loop-v15.mp4" data-theme="navy" data-alt="A reconstructed section of a Bonaire reef" data-caption="Karapata South dive site" data-details="3D photogrammetry reconstruction" data-context="Bonaire • 30 August 2026 • 1,963 m² surveyed">03 &nbsp; Benthic survey</button>
      </div>
      <div class="hero-caption">
        <p id="hero-caption-text" aria-live="polite">Colpophyllia natans coral colony • 3D photogrammetry reconstruction</p>
        <span id="hero-caption-context">Bonaire • 1 August 2023 • pre-SCTLD</span>
      </div>
    </div>
  </section>
  <section class="section section-white" id="projects">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="section-title type-section-title">Projects</h2>
          <p class="section-description">Software, visualizations, and workflows built for marine science and environmental organizations.</p>
        </div>
        <a class="text-link" href="/projects/">Explore all projects</a>
      </div>
      <div class="project-grid">
        <a class="project-card" href="/projects/network-graph.html">
          <div class="project-image dark">
            <video data-poster="/assets/network-graph.svg" width="1240" height="800" data-autoplay muted loop playsinline preload="none" aria-label="Rotating network graph of ocean data systems and organizations" data-src="/assets/network-graph.mp4?v=2" data-hls="/assets/video/network-graph/master.m3u8"></video>
          </div>
          <h3 class="card-title">Network Graph</h3>
          <p class="card-description">A visualization for exploring connections between global ocean data systems and organizations.</p>
        </a>
        <a class="project-card" href="/projects/goto-survey-viewer.html">
          <div class="project-image dark">
            <video data-poster="/assets/goto-sweep.webp?v=4" width="960" height="540" data-autoplay muted loop playsinline preload="none" aria-label="Polygon sweep and debris labels across the Terminal B walkway survey reconstruction" data-src="/assets/goto-sweep.mp4?v=4" data-hls="/assets/video/goto-sweep/master.m3u8"></video>
          </div>
          <h3 class="card-title">Goto Survey Viewer</h3>
          <p class="card-description">A viewer and labeling tool helping Rijkswaterstaat inspect underwater survey imagery and analyze marine debris.</p>
        </a>
      </div>
      <div class="small-projects">
        <article class="small-project">
          <a class="project-image" href="/projects/mimi.html" aria-label="Explore Mimi">
            <img data-src="/assets/images/mimi-thumbnail-960.webp" alt="Mimi opportunities screen showing funding amounts, timelines, and application status" width="1706" height="1316" loading="lazy" data-srcset="/assets/images/mimi-thumbnail-480.webp 480w, /assets/images/mimi-thumbnail-960.webp 960w, /assets/images/mimi-thumbnail-1706.webp 1706w" sizes="(max-width:700px) calc(100vw - 40px), (max-width:1000px) calc((100vw - 64px) / 3 - 32px), (max-width:1432px) calc((100vw - 112px) / 3 - 32px), 408px"></a>
          <h3><a href="/projects/mimi.html">Mimi</a></h3>
          <p>A custom CRM for tracking funding opportunities and customer relationships at Ocean Agentics.</p>
        </article>
        <article class="small-project">
          <a class="project-image terminal-preview" href="/projects/deeptime.html" aria-label="Explore Deeptime"><span class="terminal-window">
              <img class="terminal-screen" data-src="/assets/images/deeptime-terminal-1432.webp" alt="Terminal showing Bonaire Baseline batch-processing stages and reconstruction progress in Metashape" width="1432" height="732" loading="lazy" data-srcset="/assets/images/deeptime-terminal-480.webp 480w, /assets/images/deeptime-terminal-1432.webp 1432w" sizes="(max-width:700px) calc(100vw - 40px), (max-width:1000px) calc((100vw - 64px) / 3 - 32px), (max-width:1432px) calc((100vw - 112px) / 3 - 32px), 408px"></span></a>
          <h3><a href="/projects/deeptime.html">Deeptime</a></h3>
          <p>An automated pipeline for turning underwater survey imagery into 3D reconstructions, reef maps, and GIS outputs.</p>
        </article>
        <article class="small-project">
          <a class="project-image" href="/projects/scout.html" aria-label="Explore Scout">
            <img class="scout-screenshot" data-src="/assets/images/scout-slack-1560.webp" alt="Scout Slack integration delivering BBNJ announcements with source links" width="1560" height="912" loading="lazy" data-srcset="/assets/images/scout-slack-480.webp 480w, /assets/images/scout-slack-960.webp 960w, /assets/images/scout-slack-1560.webp 1560w" sizes="(max-width:700px) calc(100vw - 40px), (max-width:1000px) calc((100vw - 64px) / 3 - 32px), (max-width:1432px) calc((100vw - 112px) / 3 - 32px), 408px"></a>
          <h3><a href="/projects/scout.html">Scout</a></h3>
          <p>Automated tracking of High Seas Treaty events, webinars, and announcements for Ocean Agentics.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="section" id="research">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="section-title type-section-title">Research</h2>
          <p class="section-description">Published studies concerning marine environments and human impacts.</p>
        </div>
        <a class="text-link" href="/research/">Explore all research</a>
      </div>
      <a class="publication" href="https://doi.org/10.59448/jah.v2i1.15" target="_blank" rel="noopener"><span class="year"><span class="eyebrow">Published</span><br><time datetime="2022-05-31">May 2022</time></span>
        <div>
          <h3>Mercury in dried market fish of Hong Kong and San Francisco: Human health implications</h3>
          <p>Vallentyne D., Zhao Z., Lee T. Y., McGuire D.</p>
          <p><em>Journal of Asian Health</em>, 2(1).</p>
        </div>
      </a>
      <a class="publication" href="https://doi.org/10.1111/faf.12676" target="_blank" rel="noopener"><span class="year"><span class="eyebrow">Published</span><br><time datetime="2022-05-24">May 2022</time></span>
        <div>
          <h3>Spatially explicit risk assessment of marine megafauna vulnerability to Indian Ocean tuna fisheries</h3>
          <p>Roberson L., Wilcox C., Boussarie G., Dugan E., Garilao C., Gonzalez K., Green M., Kark S., Kaschner K., Klein C. J., Rousseau Y., Vallentyne D., Watson J. E. M., Kiszka J. J.</p>
          <p><em>Fish and Fisheries</em>, 23(5), 1180–1201.</p>
        </div>
      </a>
    </div>
  </section>
  <section class="section section-white" id="expeditions">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="section-title type-section-title">Expeditions</h2>
          <p class="section-description">Field campaigns, underwater surveys, and research diving.</p>
        </div>
        <a class="text-link" href="/expeditions/">Explore all expeditions</a>
      </div>
      <div class="expedition-grid">
        <a class="project-card" href="/expeditions/bonaire-baseline.html">
          <div class="project-image">
            <img data-src="/assets/images/baseline-field-1600.webp" alt="A diver documenting a Bonaire reef with a paired-camera survey rig" width="2048" height="1536" loading="lazy" data-srcset="/assets/images/baseline-field-480.webp 480w, /assets/images/baseline-field-960.webp 960w, /assets/images/baseline-field-1600.webp 1600w, /assets/baseline-field.jpg 2048w" sizes="(max-width:700px) calc(100vw - 40px), (max-width:1000px) calc((100vw - 100px) / 2), (max-width:1432px) calc((100vw - 148px) / 2), 642px">
          </div>
          <h3 class="card-title">Bonaire Baseline Surveys</h3>
          <p class="card-description">Bonaire · 2023 and 2026. Custom survey equipment and repeat reef mapping, including a 2026 campaign covering 18 sites.</p>
        </a>
        <a class="project-card" href="/expeditions/goto-terminal.html">
          <div class="project-image">
            <img data-src="/assets/goto-terminal.webp?v=20261005-104139" alt="The Goto terminal structure photographed from the water, October 2026" width="1600" height="739" loading="lazy">
          </div>
          <h3 class="card-title">Goto Terminal Survey</h3>
          <p class="card-description">Photogrammetry beneath the Goto terminals for Rijkswaterstaat, documenting marine debris and reef condition.</p>
        </a>
      </div>
    </div>
  </section>
</SiteLayout>
