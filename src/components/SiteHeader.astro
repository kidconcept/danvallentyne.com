---
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/research/', label: 'Research' },
  { href: '/expeditions/', label: 'Expeditions' },
  { href: '/about.html', label: 'About' },
  { href: '/contact.html', label: 'Contact' },
];
const { pathname } = Astro.url;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="wordmark" href="/" aria-label="Dan Vallentyne, home">Dan Vallentyne</a>
    <button class="menu-button" aria-expanded="false" aria-controls="main-nav">Menu +</button>
    <nav class="main-nav" id="main-nav" aria-label="Main navigation">
      {links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={
            pathname === href ||
            (href.endsWith('/')
              ? pathname === href.slice(0, -1) || pathname.startsWith(href)
              : pathname === href.slice(0, -5))
              ? 'page'
              : undefined
          }
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
