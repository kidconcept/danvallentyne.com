---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<footer class:list={['contact-footer', { 'footer-compact': compact }]} id="footer">
  <div class="wrap">
    {!compact && (
      <div class="footer-top">
        <img class="footer-portrait" src="/assets/danny-vallentyne.jpg" alt="Dan Vallentyne scuba diving" width="960" height="640" loading="lazy">
        <div class="footer-copy">
          <h2>Connecting fieldwork, research, and design</h2>
          <p class="footer-description">My work brings together experience in product design, underwater research, and scientific publishing. I'm interested in ecological change, deep time, and how people participate in thriving ecosystems across generations.</p>
          <div class="footer-links">
            <a class="text-link" href="/about.html">More about me</a>
            <a class="text-link" href="/contact.html">Discuss a project</a>
          </div>
        </div>
      </div>
    )}
    <div class="footer-bottom">
      <a class="footer-brand" href="/" aria-label="Home"><img src="/favicon.svg" alt="" width="64" height="64"></a>
      <nav class="social-links" aria-label="Footer">
        <a href="/about.html">About</a>
        <a href="/contact.html">Contact</a>
        <a href="https://github.com/kidconcept">GitHub</a>
        <a href="https://www.linkedin.com/in/danvallentyne">LinkedIn</a>
        <a href="/credits.html">Image sources</a>
      </nav>
    </div>
  </div>
</footer>
